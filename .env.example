# Copy this file to `.env` for local secrets and machine-specific defaults.
# Do not commit `.env`.

# Hosted Trace / otrace.
# Create this in the Trace UI or with the Trace onboarding flow.
TRACE_API_KEY=replace-with-trace-api-key

# Optional Trace controls for `paper/trace_run.sh`.
# Calling the wrapper means "trace this"; use 0 only for an explicit local opt-out.
EVENTPDF_USE_TRACE=1
EVENTPDF_TRACE_REQUIRED=1
EVENTPDF_TRACE_CLI="uvx --from origami-trace otrace"

# Optional W&B settings. Local artifacts under `experiments/` remain canonical.
WANDB_MODE=offline
WANDB_PROJECT=event-detection-pdf
# WANDB_API_KEY=your_wandb_key_here

# Optional Kaggle API credentials if not using `kaggle.json`.
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_kaggle_key
